{
  "name": "nextjs_tailwind_shadcn_ts",
  "version": "0.2.1",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 2>&1 | tee dev.log",
    "build": "next build",
    "build:standalone": "next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "fonts:fetch": "bun scripts/fetch-fonts.ts",
    "postinstall": "prisma generate",
    "start": "NODE_ENV=production bun .next/standalone/server.js 2>&1 | tee server.log",
    "lint": "eslint .",
    "db:push": "prisma db push --accept-data-loss",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "db:remove:demo-bags": "bun --env-file=.env scripts/remove-demo-bags.ts",
    "db:seed:points": "bun --env-file=.env scripts/seed-demo-points.ts",
    "db:fix:shared-projects": "bun --env-file=.env scripts/fix-shared-projects.ts",
    "verify:launch": "bun --env-file=.env scripts/verify-launch-flag.ts",
    "verify:profile-number": "bun --env-file=.env scripts/verify-profile-number.ts",
    "verify:admin-campaigns": "bun --env-file=.env scripts/verify-admin-campaigns.ts",
    "verify:funding": "tsc scripts/verify-funding.ts --outDir .vftmp --module commonjs --target es2022 --moduleResolution node --esModuleInterop --skipLibCheck && node --env-file=.env .vftmp/scripts/verify-funding.js",
    "verify:alchemy": "bun --env-file=.env scripts/verify-alchemy.ts",
    "verify:journey": "bun --env-file=.env scripts/verify-journey.ts",
    "perf:endpoints": "bun scripts/perf-endpoints.ts"
  },
